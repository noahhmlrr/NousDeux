rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Pas de "list" sur /couples : impossible d'énumérer les espaces, il faut connaître le code.
    match /couples/{code} {
      allow get, create, update: if request.auth != null;
      match /devices/{uid} {
        allow read: if false;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["token", "role", "updatedAt"])
          && request.resource.data.token is string
          && request.resource.data.role in ["Noah", "Ally"];
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      match /events/{id} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
